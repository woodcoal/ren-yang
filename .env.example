# 复制为仓库外或本机忽略的环境配置，并填写至少 32 个字符的随机值。
NUXT_SESSION_PASSWORD=

# 可选：覆盖默认的 ./data 运行时数据目录。
NUXT_DATA_DIRECTORY=./data

# 文本模型使用完整 OpenAI-compatible Chat Completions 地址；三项均填写后启用。
NUXT_TEXT_MODEL_ENDPOINT=
NUXT_TEXT_MODEL_API_KEY=
NUXT_TEXT_MODEL_MODEL=

# 可选图片模型；留空时纯文本路径仍可使用。
NUXT_IMAGE_MODEL_ENDPOINT=
NUXT_IMAGE_MODEL_API_KEY=
NUXT_IMAGE_MODEL_MODEL=

# 默认关闭低风险人物修订自动发布；开启后仍必须先通过全部固定评测门禁。
NUXT_FEEDBACK_AUTO_PUBLISH_LOW_RISK=false

# 可选 OpenViking；关闭时使用 SQLite FTS5，SQLite 始终是唯一业务事实源。
NUXT_OPEN_VIKING_ENABLED=false
NUXT_OPEN_VIKING_ENDPOINT=
NUXT_OPEN_VIKING_API_KEY=
NUXT_OPEN_VIKING_TIMEOUT_MS=60000
