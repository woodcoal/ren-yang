{
  "name": "ren-yang",
  "version": "1.26.901",
  "description": "单人本地运行的 AI 人物模拟、兴趣判断与结构化图文创作工作台",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "woodcoal",
  "homepage": "https://github.com/woodcoal/ren-yang#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woodcoal/ren-yang.git"
  },
  "bugs": {
    "url": "https://github.com/woodcoal/ren-yang/issues"
  },
  "keywords": [
    "ai-persona",
    "content-generation",
    "nuxt",
    "openviking"
  ],
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build --dotenv .env.build",
    "start": "node .output/server/index.mjs",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "tsx tests/e2e/prepare-environment.ts && playwright test",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "migrate": "tsx scripts/migrate.ts",
    "admin:reset-password": "tsx scripts/reset-administrator-password.ts",
    "backup": "tsx scripts/backup.ts",
    "restore:validate": "tsx scripts/restore-validate.ts",
    "restore": "tsx scripts/restore.ts"
  },
  "dependencies": {
    "@adonisjs/hash": "^10.1.1",
    "@nuxt/ui": "^4.11.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "fflate": "^0.8.3",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@vue/test-utils": "^2.5.0",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^20.12.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
